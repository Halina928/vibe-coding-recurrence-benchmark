+def _extract_via_tar(cid: str, dest: str) -> None:
+    """Windows fallback: docker cp as a tar stream and skip symlinks.
+
+    docker cp creates nested symlinks on the Windows filesystem, which needs
+    SeCreateSymbolicLinkPrivilege (admin / Developer Mode). Some repos (ceph)
+    contain symlinks, so the direct copy fails. Reading the tar stream and
+    dropping symlink entries avoids the privilege entirely.
+    """
+    import io
+    import tarfile
+
+    p = subprocess.run(["docker", "cp", cid + ":/project", "-"], capture_output=True)
+    if p.returncode != 0:
+        raise SandboxError("docker cp (tar) 失败：" + p.stderr.decode("utf-8", "replace")[-800:])
+    with tarfile.open(fileobj=io.BytesIO(p.stdout)) as tf:
+        members = []
+        for m in tf.getmembers():
+            if m.issym() or m.islnk():
+                continue
+            name = m.name
+            if name == "project":
+                name = "."
+            elif name.startswith("project/"):
+                name = name[len("project/"):]
+            else:
+                continue
+            m.name = name
+            members.append(m)
+        tf.extractall(dest, members=members)
+
+
